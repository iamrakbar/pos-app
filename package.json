{
  "name": "pos-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "start:preview": "APP_VARIANT=preview expo start --dev-client",
    "start:production": "APP_VARIANT=production expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "android:preview": "APP_VARIANT=preview expo run:android --variant release",
    "android:production": "APP_VARIANT=production expo run:android --variant release",
    "ios": "APP_VARIANT=development expo run:ios",
    "ios:preview": "APP_VARIANT=preview expo run:ios --configuration Release",
    "ios:production": "APP_VARIANT=production expo run:ios --configuration Release",
    "config:dev": "APP_VARIANT=development expo config",
    "config:preview": "APP_VARIANT=preview expo config",
    "config:production": "APP_VARIANT=production expo config",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:preview": "APP_VARIANT=preview expo prebuild --clean",
    "prebuild:production": "APP_VARIANT=production expo prebuild --clean",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "lint": "npm run localization:check && eslint . --ignore-pattern .agents",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "localization:check": "node scripts/check-localization.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.27",
    "@haroldtran/react-native-thermal-printer": "^1.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react-native": "^1.0.16",
    "@lodev09/react-native-true-sheet": "^3.11.9",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-media-library": "~58.0.13",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-observe": "~58.0.18",
    "expo-router": "~58.0.30",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "panelui-native": "^0.115.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.81.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-mcp": "~0.2.1",
    "panelwind": "^0.2.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@haroldtran/react-native-thermal-printer",
          "react-native-ping"
        ]
      }
    }
  },
  "patchedDependencies": {
    "@haroldtran/react-native-thermal-printer@1.2.0": "patches/@haroldtran%2Freact-native-thermal-printer@1.2.0.patch"
  }
}
