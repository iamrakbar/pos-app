{
  "name": "pos-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start --dev-client",
    "start:preview": "APP_VARIANT=preview expo start --dev-client",
    "start:production": "APP_VARIANT=production expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "android:preview": "APP_VARIANT=preview expo run:android --variant release",
    "android:production": "APP_VARIANT=production expo run:android --variant release",
    "ios": "APP_VARIANT=development expo run:ios",
    "ios:preview": "APP_VARIANT=preview expo run:ios --configuration Release",
    "ios:production": "APP_VARIANT=production expo run:ios --configuration Release",
    "config:dev": "APP_VARIANT=development expo config",
    "config:preview": "APP_VARIANT=preview expo config",
    "config:production": "APP_VARIANT=production expo config",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:preview": "APP_VARIANT=preview expo prebuild --clean",
    "prebuild:production": "APP_VARIANT=production expo prebuild --clean",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "lint": "npm run localization:check && eslint . --ignore-pattern .agents",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "localization:check": "node scripts/check-localization.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/ui": "~57.0.26",
    "@haroldtran/react-native-thermal-printer": "^1.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react-native": "^1.0.16",
    "@lodev09/react-native-true-sheet": "^3.11.9",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.31",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-observe": "~57.0.26",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "panelui-native": "^0.115.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.15",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "expo-mcp": "~0.2.1",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@haroldtran/react-native-thermal-printer",
          "react-native-ping"
        ]
      }
    }
  }
}
